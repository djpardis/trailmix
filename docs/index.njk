---
permalink: index.html
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ readme.title }} | Open tempo, key, and waveform analysis</title>
    <meta name="description" content="{{ readme.description }}">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="https://trailmix.tools/">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ readme.title }}">
    <meta property="og:description" content="{{ readme.description }}">
    <meta property="og:url" content="https://trailmix.tools/">
    <meta property="og:image" content="https://trailmix.tools/assets/trail-mix-social-card.png?v=1">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://trailmix.tools/assets/trail-mix-social-card.png?v=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=DM+Sans:wght@400;500;600;700&amp;display=swap"
    >
    <link rel="stylesheet" href="/styles.css?v={{ assetVersion }}">
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo-lockup" href="/">
          <img
            class="brand-mark"
            src="/assets/trail-mix.png?v=3"
            alt="trail mix"
          >
          <span class="brand-title">{{ readme.title }}</span>
          <span class="header-badge">Rust</span>
        </a>
        <nav class="site-nav" aria-label="Project links">
          <a class="nav-link architecture-link" href="/architecture/" aria-label="Architecture">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 5h6v6H5z"/>
              <path d="M13 5h6v6h-6z"/>
              <path d="M5 13h6v6H5z"/>
              <path d="M13 13h6v6h-6z"/>
            </svg>
            <span>Architecture</span>
          </a>
          <a class="repository-link" href="https://github.com/djpardis/trailmix" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.6 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.92c-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.99a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.77c0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.26C22 6.6 17.52 2 12 2Z"/>
            </svg>
            <span>Source</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="project-main">
      <div class="project-grid">

        <div class="col-main">

          <section aria-labelledby="project-title">
            <h1 id="project-title">{{ readme.title }}</h1>
            <div class="intro-body">
              <div class="intro-text">{{ readme.introHtml | safe }}</div>
              <img
                class="project-art intro-art"
                src="/assets/trail-mix.png?v=3"
                alt="An illustrated mix of nuts, seeds, raisins, and chocolate"
              >
            </div>
          </section>

          {% for section in readme.sections %}
            {% if section.slug == "quick-start" %}
              <article id="{{ section.slug }}">
                <h2>{{ section.title }}</h2>
                <div class="section-content">{{ section.html | safe }}</div>
              </article>
            {% endif %}
          {% endfor %}

        </div>

        <div class="col-side">

          {% for section in readme.sections %}
            {% if section.slug == "design-principles" or section.slug == "accuracy-and-next-step" %}
              <article id="{{ section.slug }}">
                <h2>{{ section.title }}</h2>
                <div class="section-content">{{ section.html | safe }}</div>
              </article>
            {% endif %}
          {% endfor %}

        </div>

      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        {% for section in readme.sections %}
          {% if section.slug == "license" %}
            <div class="footer-license">{{ section.firstSentenceHtml | safe }}</div>
          {% endif %}
        {% endfor %}
        <p class="footer-copyright">&copy; {{ year }} trail mix</p>
      </div>
    </footer>
  </body>
</html>
