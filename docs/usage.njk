---
permalink: usage/index.html
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ usage.title }} | trail mix</title>
    <meta name="description" content="{{ usage.description }}">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="https://trailmix.tools/usage/">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ usage.title }} | trail mix">
    <meta property="og:description" content="{{ usage.description }}">
    <meta property="og:url" content="https://trailmix.tools/usage/">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=DM+Sans:wght@400;500;600;700&amp;display=swap"
    >
    <link rel="stylesheet" href="/styles.css?v={{ assetVersion }}">
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo-lockup" href="/">
          <img class="brand-mark" src="/assets/trail-mix.png?v=3" alt="trail mix">
          <span class="brand-title">trail mix</span>
          <span class="header-badge">Rust</span>
        </a>
        <nav class="site-nav" aria-label="Project links">
          <a class="nav-link" href="/usage/" aria-label="Usage">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <path d="M7 9l3 3-3 3"/>
              <path d="M12 15h5"/>
            </svg>
            <span>Usage</span>
          </a>
          <a class="nav-link" href="/architecture/" aria-label="Architecture">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="3" width="6" height="5" rx="1"/>
              <rect x="3" y="16" width="6" height="5" rx="1"/>
              <rect x="15" y="16" width="6" height="5" rx="1"/>
              <path d="M12 8v4M6 16v-4h12v4"/>
            </svg>
            <span>Architecture</span>
          </a>
          <a class="nav-link" href="/transformer/" aria-label="Transformer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 7l3-2M7 7l3 5M7 17l3-5M7 17l3 2M14 5l3 2M14 12l3-5M14 12l3 5M14 19l3-2"/>
              <circle cx="5" cy="7" r="2"/>
              <circle cx="5" cy="17" r="2"/>
              <circle cx="12" cy="5" r="2"/>
              <circle cx="12" cy="12" r="2"/>
              <circle cx="12" cy="19" r="2"/>
              <circle cx="19" cy="7" r="2"/>
              <circle cx="19" cy="17" r="2"/>
            </svg>
            <span>Transformer</span>
          </a>
          <a class="repository-link" href="https://github.com/djpardis/trailmix" target="_blank" rel="noopener noreferrer" aria-label="Source">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.6 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.92c-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.99a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.77c0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.26C22 6.6 17.52 2 12 2Z"/>
            </svg>
            <span>Source</span>
          </a>
        </nav>
      </div>
    </header>
    <main class="project-main">
      <div class="project-grid single-column-grid">
        <div class="col-main document-main">
          <section aria-labelledby="usage-title">
            <h1 id="usage-title">{{ usage.title }}</h1>
            <div class="intro-text">{{ usage.introHtml | safe }}</div>
          </section>
          {% for section in usage.sections %}
            <article id="{{ section.slug }}">
              <h2>{{ section.title }}</h2>
              <div class="section-content">{{ section.html | safe }}</div>
            </article>
          {% endfor %}
        </div>
      </div>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        {% for section in readme.sections %}
          {% if section.slug == "license" %}
            <div class="footer-license">{{ section.firstSentenceHtml | safe }}</div>
          {% endif %}
        {% endfor %}
        <p class="footer-copyright">&copy; {{ year }} trail mix</p>
      </div>
    </footer>
  </body>
</html>
